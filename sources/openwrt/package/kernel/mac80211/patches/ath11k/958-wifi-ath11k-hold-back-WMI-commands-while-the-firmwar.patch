From 7913697c90e093fb08b3271374dba6b26278b67b Mon Sep 17 00:00:00 2001
From: Julius Bairaktaris <julius@bairaktaris.de>
Date: Sun, 18 Oct 2026 19:28:42 +0200
Subject: [PATCH] wifi: ath11k: hold back WMI commands while the firmware
 restarts

ath11k_core_restart() brings the firmware up outside mac80211's restart,
so cfg80211 operations keep sending WMI commands while the HTC services
reconnect and before the firmware reports ready. These commands crash
the restarting firmware again, and recovery then fails on the unified
ready timeout:

  ath11k c000000.wifi: failed to receive wmi unified ready event: -110
  ath11k c000000.wifi: failed to reconfigure driver on crash recovery

Return -ESHUTDOWN for commands from outside the restart worker while
ATH11K_FLAG_RECOVERY is set. Check each send attempt, including commands
already waiting for credits or CE descriptors when recovery starts.
Wake both wait queues before draining TX. On PCI the reset worker starts
before QMI reports SERVER_EXIT, so set RECOVERY before this wakeup there
as well. Clear the recovery flag in QMI FW_READY only on initial boot;
on recovery the restart worker clears it after the firmware is ready.
mac80211 replays configuration when the driver restarts the hardware.

Backport of ath-next v3 05/13, retaining the common send-attempt guard
and accounting for the pinned PCI reset ordering.
Link: https://lore.kernel.org/r/20261121230731.1206043-6-julius@bairaktaris.de
Fixes: d5c65159f289 ("ath11k: driver for Qualcomm IEEE 802.11ax devices")
Signed-off-by: Julius Bairaktaris <julius@bairaktaris.de>
---

--- a/drivers/net/wireless/ath/ath11k/wmi.c
+++ b/drivers/net/wireless/ath/ath11k/wmi.c
@@ -280,5 +280,9 @@ static int ath11k_wmi_cmd_send_nowait(struct ath11k_pdev_wmi *wmi,
 	int ret;
 	u32 cmd = 0;
 
+	if (test_bit(ATH11K_FLAG_RECOVERY, &ab->dev_flags) &&
+	    current_work() != &ab->restart_work)
+		return -ESHUTDOWN;
+
 	if (skb_push(skb, sizeof(struct wmi_cmd_hdr)) == NULL)
 		return -ENOMEM;
--- a/drivers/net/wireless/ath/ath11k/core.c
+++ b/drivers/net/wireless/ath/ath11k/core.c
@@ -2562,6 +2562,11 @@
 	struct ath11k_pdev *pdev;
 	int i;
 
+	/* Let in-flight WMI callers exit before draining their work. */
+	wake_up(&ab->wmi_ab.tx_credits_wq);
+	for (i = 0; i < ARRAY_SIZE(ab->wmi_ab.wmi); i++)
+		wake_up(&ab->wmi_ab.wmi[i].tx_ce_desc_wq);
+
 	spin_lock_bh(&ab->base_lock);
 	ab->stats.fw_crash_counter++;
 	spin_unlock_bh(&ab->base_lock);
@@ -2598,7 +2603,6 @@
 		clear_bit(ATH11K_FLAG_MONITOR_VDEV_CREATED, &ar->monitor_flags);
 	}
 
-	wake_up(&ab->wmi_ab.tx_credits_wq);
 	wake_up(&ab->peer_mapping_wq);
 
 	reinit_completion(&ab->driver_recovery);
@@ -2719,6 +2723,7 @@
 	ath11k_dbg(ab, ATH11K_DBG_BOOT, "reset starting\n");
 
 	ab->is_reset = true;
+	set_bit(ATH11K_FLAG_RECOVERY, &ab->dev_flags);
 	atomic_set(&ab->recovery_count, 0);
 	reinit_completion(&ab->recovery_start);
 	atomic_set(&ab->recovery_start_count, 0);
--- a/drivers/net/wireless/ath/ath11k/qmi.c
+++ b/drivers/net/wireless/ath/ath11k/qmi.c
@@ -3354,10 +3354,9 @@
 			if (ab->hw_params.cbcal_restart_fw)
 				break;
 
-			clear_bit(ATH11K_FLAG_CRASH_FLUSH,
-				  &ab->dev_flags);
-			clear_bit(ATH11K_FLAG_RECOVERY, &ab->dev_flags);
 			if (!test_bit(ATH11K_FLAG_REGISTERED, &ab->dev_flags)) {
+				clear_bit(ATH11K_FLAG_CRASH_FLUSH, &ab->dev_flags);
+				clear_bit(ATH11K_FLAG_RECOVERY, &ab->dev_flags);
 				ret = ath11k_core_qmi_firmware_ready(ab);
 				if (ret) {
 					set_bit(ATH11K_FLAG_QMI_FAIL, &ab->dev_flags);
