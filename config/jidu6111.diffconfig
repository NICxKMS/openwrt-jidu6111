CONFIG_TARGET_qualcommbe=y
CONFIG_TARGET_qualcommbe_ipq95xx=y
CONFIG_TARGET_qualcommbe_ipq95xx_DEVICE_jiorouter_ax6000-jidu6111=y
CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_DEVEL=y
# CONFIG_CCACHE is not set
# CONFIG_BUILD_LOG is not set

# Web management in the base image. Board drivers come from the device profile.
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y

# Offline network diagnostics and configuration repair
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_tcpdump-mini=y
CONFIG_PACKAGE_usbutils=y

# Read and write backups on common USB drives without a package repository.
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y

# Android USB tethering as a backup uplink. Configure the interface in LuCI.
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y

# Traffic shaping
CONFIG_PACKAGE_luci-app-sqm=m

# Pick one DNS filtering service when configuring the router.
CONFIG_PACKAGE_luci-app-adguardhome=m
CONFIG_PACKAGE_luci-app-adblock-fast=m
CONFIG_PACKAGE_luci-app-https-dns-proxy=m

# Monitoring and diagnostics
CONFIG_PACKAGE_luci-app-nlbwmon=m
CONFIG_PACKAGE_luci-app-statistics=m
CONFIG_PACKAGE_collectd-mod-ping=m
CONFIG_PACKAGE_collectd-mod-thermal=m
CONFIG_PACKAGE_iperf3=m
CONFIG_PACKAGE_ip-full=m
CONFIG_PACKAGE_htop=m

# Additional USB adapters, storage formats, and disk utilities
CONFIG_PACKAGE_kmod-usb-net-rtl8152=m
CONFIG_PACKAGE_kmod-usb-net-asix-ax88179=m
CONFIG_PACKAGE_kmod-usb-storage-extras=m
CONFIG_PACKAGE_kmod-fs-ntfs3=m
CONFIG_PACKAGE_blkid=m
CONFIG_PACKAGE_dosfstools=m
CONFIG_PACKAGE_fdisk=m

# Compressed swap and optional VPN kernel support
CONFIG_PACKAGE_zram-swap=m
CONFIG_PACKAGE_luci-proto-wireguard=m
CONFIG_PACKAGE_kmod-tun=m
